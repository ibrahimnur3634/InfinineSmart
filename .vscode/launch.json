{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Attach to Chrome",
      "port": 9222,
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Open site in Edge",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "file:///C:/Users/Administrator/OneDrive/Desktop/My%20first%20website/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Open site in Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "file:///C:/Users/Administrator/OneDrive/Desktop/My%20first%20website/index.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}